{
  "id": "theme-matrix",
  "version": "0.1.1",
  "api": 1,
  "squadron": ">=0.47.0",
  "name": {
    "en": "Matrix theme",
    "fr": "Thème Matrix"
  },
  "description": {
    "en": "Phosphor green on black, and a Digital rain panel where green code falls. Pick it in Settings › Theme.",
    "fr": "Du vert phosphore sur fond noir, et un panneau Pluie de code où tombent des caractères verts. Choisissez-le dans Réglages › Thème."
  },
  "logo": "matrix.svg",
  "contributes": {
    "items": [
      {
        "slot": "agent.tools",
        "id": "rain",
        "label": {
          "en": "Digital rain",
          "fr": "Pluie de code"
        },
        "hint": {
          "en": "Let green code rain down",
          "fr": "Faire tomber la pluie de code verte"
        },
        "icon": "logo",
        "action": {
          "panel.open": "rain"
        }
      },
      {
        "slot": "agent.menu",
        "id": "rain-menu",
        "label": {
          "en": "Enter the Matrix",
          "fr": "Entrer dans la Matrice"
        },
        "icon": "logo",
        "action": {
          "panel.open": "rain"
        }
      }
    ],
    "panels": [
      {
        "id": "rain",
        "title": {
          "en": "Digital rain",
          "fr": "Pluie de code"
        },
        "page": "rain.html"
      }
    ],
    "theme": {
